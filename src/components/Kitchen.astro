---
import { withBase } from '../data/site';

const menuPdf = withBase('/menu-station-one.pdf');

/** Categories from the PDF menu + meal windows while cafe is open 12:00–01:00 */
const dishes = [
  {
    src: withBase('/assets/kitchen-breakfast.webp'),
    alt: 'Закуски Station One Cafe',
    label: 'Закуски',
    time: '12:00–16:00',
    pdfPage: 2,
    captionPos: 'top' as const,
  },
  {
    src: withBase('/assets/kitchen-lunch.webp'),
    alt: 'Основные блюда Station One Cafe',
    label: 'Горячее',
    time: '12:00–18:00',
    pdfPage: 6,
    captionPos: 'center' as const,
  },
  {
    src: withBase('/assets/kitchen-dinner.webp'),
    alt: 'Пицца и ужин в Station One Cafe',
    label: 'Пицца',
    time: '18:00–01:00',
    pdfPage: 7,
    captionPos: 'top' as const,
  },
];
---

<section id="kitchen" class="section-pad bg-navy" data-kitchen>
  <div class="mx-auto max-w-7xl">
    <div class="max-w-xl">
      <p class="text-xs font-medium uppercase tracking-[0.3em] text-gold">Кухня</p>
      <div class="section-heading mt-4">
        <h2
          class="section-heading-gold font-display text-4xl font-bold leading-tight md:text-5xl"
        >
          Вкус, который хочется разделить
        </h2>
        <span class="section-heading-rule" aria-hidden="true"></span>
      </div>
      <p class="mt-5 text-base font-light leading-relaxed text-silver">
        Меню Station One — <span class="text-accent">авторская подача</span>,
        <span class="text-accent">знакомые блюда</span>, от лёгкого обеда до
        <span class="text-accent">вечернего десерта</span>.
      </p>
      <a
        href={menuPdf}
        target="_blank"
        rel="noopener noreferrer"
        class="book-btn mt-8"
      >
        Полное меню
      </a>
    </div>

    <div class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        dishes.map((dish, index) => (
          <a
            href={`${menuPdf}#page=${dish.pdfPage}`}
            target="_blank"
            rel="noopener noreferrer"
            class="kitchen-card group relative block overflow-hidden"
            style={`--dish-delay: ${index * 0.2}s`}
          >
            <img
              src={dish.src}
              alt={dish.alt}
              class="aspect-[3/4] w-full object-cover transition duration-700 group-hover:scale-[1.04]"
              loading="lazy"
            />
            <div
              class:list={[
                'pointer-events-none absolute inset-0 bg-gradient-to-b from-navy/70 via-transparent to-navy/80',
              ]}
            />
            <div
              class:list={[
                'kitchen-caption absolute z-10 px-4',
                dish.captionPos === 'center'
                  ? 'inset-0 flex flex-col items-center justify-center text-center'
                  : 'left-0 top-0 pt-5 text-left',
              ]}
            >
              <span class="font-display text-2xl font-bold tracking-wide text-champagne md:text-3xl">
                {dish.label}
              </span>
              <span class="mt-1 block font-display text-sm font-semibold italic tracking-[0.14em] text-gold md:text-base">
                {dish.time}
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .kitchen-card {
    opacity: 1;
  }

  @media (min-width: 768px) {
    html.js-ready [data-kitchen]:not(.is-visible) .kitchen-card {
      opacity: 0;
      transform: translateY(1.5rem) scale(0.96);
    }

    [data-kitchen].is-visible .kitchen-card {
      animation: kitchen-card-reveal 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: var(--dish-delay, 0s);
    }
  }

  @media (max-width: 767px) {
    html.js-ready .kitchen-card:not(.is-visible) {
      opacity: 0;
      transform: translateY(1.25rem);
    }

    .kitchen-card {
      transition:
        opacity 0.7s ease,
        transform 0.7s ease;
    }

    .kitchen-card.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes kitchen-card-reveal {
    from {
      opacity: 0;
      transform: translateY(1.5rem) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kitchen-card,
    .kitchen-card.is-visible,
    [data-kitchen].is-visible .kitchen-card,
    html.js-ready [data-kitchen]:not(.is-visible) .kitchen-card,
    html.js-ready .kitchen-card:not(.is-visible) {
      opacity: 1;
      transform: none;
      transition: none;
      animation: none;
    }
  }
</style>

<script>
  document.documentElement.classList.add('js-ready');
  const section = document.querySelector<HTMLElement>('[data-kitchen]');
  if (section) {
    const cards = [...section.querySelectorAll<HTMLElement>('.kitchen-card')];
    const desktopQuery = window.matchMedia('(min-width: 768px)');
    let observer: IntersectionObserver | null = null;

    const clear = () => {
      observer?.disconnect();
      observer = null;
      section.classList.remove('is-visible');
      cards.forEach((card) => card.classList.remove('is-visible'));
    };

    const setup = () => {
      clear();

      if (!('IntersectionObserver' in window)) {
        section.classList.add('is-visible');
        cards.forEach((card) => card.classList.add('is-visible'));
        return;
      }

      if (desktopQuery.matches) {
        observer = new IntersectionObserver(
          ([entry]) => {
            section.classList.toggle('is-visible', entry.isIntersecting);
          },
          { threshold: 0.18, rootMargin: '0px 0px -6% 0px' },
        );
        observer.observe(section);
        return;
      }

      observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            entry.target.classList.toggle('is-visible', entry.isIntersecting);
          });
        },
        { threshold: 1 / 3 },
      );
      cards.forEach((card) => observer?.observe(card));
    };

    setup();
    desktopQuery.addEventListener('change', setup);
  }
</script>
