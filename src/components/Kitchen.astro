---
import { withBase } from '../data/site';

const menuPdf = withBase('/menu-station-one.pdf');

const categories = [
  { title: 'Закуски', page: 2, image: 'kitchen-zakuski.webp' },
  { title: 'Рекомендуем', page: 3, image: 'kitchen-recommend.webp' },
  { title: 'Салаты', page: 3, image: 'kitchen-salaty.webp' },
  { title: 'Супы', page: 4, image: 'kitchen-soups.webp' },
  { title: 'Сэндвичи', page: 4, image: 'kitchen-sandwich.webp' },
  { title: 'На углях', page: 5, image: 'kitchen-uglyakh.webp' },
  { title: 'На компанию', page: 6, image: 'kitchen-kompaniya.webp' },
  { title: 'Пицца', page: 7, image: 'kitchen-pizza.webp' },
  { title: 'Паста', page: 8, image: 'kitchen-pasta.webp' },
  { title: 'Детское Меню', page: 8, image: 'kitchen-kids.webp' },
  { title: 'Десерты', page: 9, image: 'kitchen-desserty.webp' },
  { title: 'Бизнес ланч', page: 11, image: 'kitchen-lunch-biz.webp', time: '12:00 – 16:00' },
].map((item) => ({
  ...item,
  href: `${menuPdf}#page=${item.page}`,
  src: withBase(`/assets/${item.image}`),
}));
---

<section id="kitchen" class="section-pad bg-navy-deep" data-kitchen>
  <div class="mx-auto max-w-7xl text-center">
    <div class="mx-auto max-w-xl">
      <div class="section-heading">
        <h2
          class="section-heading-gold font-display text-4xl font-semibold leading-tight md:text-5xl"
        >
          Вкус, который хочется разделить
        </h2>
        <span class="section-heading-rule" aria-hidden="true"></span>
      </div>
      <p class="mt-5 font-accent text-base font-medium leading-relaxed text-silver md:text-lg">
        Меню кафе Station One в Гомеле — авторская подача и знакомые блюда
      </p>
    </div>

    <div class="mt-12 grid grid-cols-2 gap-2.5 sm:gap-3 md:grid-cols-6 md:gap-3">
      {
        categories.map((item, index) => (
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            class="kitchen-card group relative aspect-square overflow-hidden"
            style={`--dish-delay: ${(index % 6) * 0.06}s`}
            aria-label={`${item.title} — открыть в меню PDF`}
          >
            <img
              src={item.src}
              alt=""
              class="absolute inset-0 size-full object-cover transition duration-700 group-hover:scale-[1.05]"
              loading="lazy"
              decoding="async"
              aria-hidden="true"
            />
            <div
              class="pointer-events-none absolute inset-0 bg-gradient-to-b from-navy-deep/55 via-navy-deep/45 to-navy-deep/70 transition duration-500 group-hover:from-navy-deep/45 group-hover:via-navy-deep/35 group-hover:to-navy-deep/60"
              aria-hidden="true"
            />
            <span class="kitchen-caption absolute inset-0 z-10 flex flex-col items-center justify-center gap-1 px-2 text-center sm:px-3">
              <span class="font-display text-[clamp(0.95rem,2.8vw,1.35rem)] font-semibold leading-tight tracking-wide text-champagne">
                {item.title}
              </span>
              {item.time ? (
                <span class="font-accent text-[0.65rem] font-medium tracking-wide text-gold sm:text-xs">
                  {item.time}
                </span>
              ) : null}
            </span>
          </a>
        ))
      }
    </div>

    <div class="mt-10">
      <a
        href={menuPdf}
        target="_blank"
        rel="noopener noreferrer"
        class="book-btn"
      >
        Меню
      </a>
    </div>
  </div>
</section>

<style>
  .kitchen-caption span {
    text-shadow:
      0 1px 2px rgb(0 0 0 / 0.85),
      0 4px 18px rgb(0 0 0 / 0.55);
  }

  .kitchen-card {
    opacity: 1;
    border: 1px solid rgb(212 175 55 / 0.18);
    background: rgb(22 23 26 / 0.85);
  }

  .kitchen-card:hover {
    border-color: rgb(212 175 55 / 0.45);
  }

  @media (min-width: 768px) {
    html.js-ready [data-kitchen]:not(.is-visible) .kitchen-card {
      opacity: 0;
      transform: translateY(1.5rem) scale(0.96);
    }

    [data-kitchen].is-visible .kitchen-card {
      animation: kitchen-card-reveal 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: var(--dish-delay, 0s);
    }
  }

  @media (max-width: 767px) {
    html.js-ready .kitchen-card:not(.is-visible) {
      opacity: 0;
      transform: translateY(1.25rem);
    }

    .kitchen-card {
      transition:
        opacity 0.65s ease,
        transform 0.65s ease,
        border-color 0.3s ease;
    }

    .kitchen-card.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes kitchen-card-reveal {
    from {
      opacity: 0;
      transform: translateY(1.5rem) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kitchen-card,
    .kitchen-card.is-visible,
    [data-kitchen].is-visible .kitchen-card,
    html.js-ready [data-kitchen]:not(.is-visible) .kitchen-card,
    html.js-ready .kitchen-card:not(.is-visible) {
      opacity: 1;
      transform: none;
      transition: none;
      animation: none;
    }
  }
</style>

<script>
  document.documentElement.classList.add('js-ready');
  const section = document.querySelector<HTMLElement>('[data-kitchen]');
  if (section) {
    const cards = [...section.querySelectorAll<HTMLElement>('.kitchen-card')];
    const desktopQuery = window.matchMedia('(min-width: 768px)');
    let observer: IntersectionObserver | null = null;

    const clear = () => {
      observer?.disconnect();
      observer = null;
      section.classList.remove('is-visible');
      cards.forEach((card) => card.classList.remove('is-visible'));
    };

    const setup = () => {
      clear();

      if (!('IntersectionObserver' in window)) {
        section.classList.add('is-visible');
        cards.forEach((card) => card.classList.add('is-visible'));
        return;
      }

      if (desktopQuery.matches) {
        observer = new IntersectionObserver(
          ([entry]) => {
            section.classList.toggle('is-visible', entry.isIntersecting);
          },
          { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
        );
        observer.observe(section);
        return;
      }

      observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            entry.target.classList.toggle('is-visible', entry.isIntersecting);
          });
        },
        { threshold: 0.25 },
      );
      cards.forEach((card) => observer?.observe(card));
    };

    setup();
    desktopQuery.addEventListener('change', setup);
  }
</script>
