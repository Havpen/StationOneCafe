---
const services = [
  {
    name: 'Яндекс Еда',
    href: 'https://eda.yandex.by/r/station_one',
    icon: '/icons/yandex-eda.webp',
  },
  {
    name: 'Just Eat',
    href: 'https://just-eat.by/station-one-gomel',
    icon: '/icons/just-eat.webp',
  },
];

/* Gentle S-wave: left valley → center peak (under subtitle) → right valley */
const roadPath =
  'M -80 192 C 80 172 180 232 300 216 C 420 199 510 132 600 136 C 690 140 780 212 900 220 C 1000 226 1120 176 1280 186';
---

<section
  id="delivery"
  class="section-pad relative overflow-hidden bg-navy border-y border-white/5"
  data-delivery
>
  <div class="relative z-10 mx-auto max-w-7xl">
    <div class="mx-auto max-w-xl text-center">
      <div class="section-heading section-heading-center">
        <h2
          class="section-heading-gold font-display text-5xl font-semibold leading-tight md:text-6xl lg:text-7xl"
        >
          Заказать с доставкой
        </h2>
        <span class="section-heading-rule section-heading-rule-short" aria-hidden="true"></span>
      </div>
      <p class="mt-5 text-base font-light leading-relaxed text-silver">
        Выберите удобный сервис — меню Station One Cafe уже там. Закажите еду с
        доставкой по Гомелю через Яндекс Еду или Just Eat.
      </p>
    </div>

    <div class="mt-14 flex flex-wrap items-start justify-center gap-12 sm:gap-20 md:gap-28">
      {
        services.map((service) => (
          <a
            href={service.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex w-36 flex-col items-center gap-4 sm:w-40"
          >
            <span class="block size-[5.5rem] overflow-hidden rounded-2xl transition duration-300 group-hover:-translate-y-1 sm:size-28">
              <img
                src={service.icon}
                alt={service.name}
                class="size-full rounded-2xl object-cover"
                width="112"
                height="112"
                loading="lazy"
              />
            </span>
            <span class="flex flex-col items-center gap-2">
              <span class="text-base font-medium text-white sm:text-lg">{service.name}</span>
              <span
                class="delivery-line h-px w-20 origin-center scale-x-[0.7] bg-gold group-hover:scale-x-100 group-hover:bg-champagne"
                aria-hidden="true"
              />
            </span>
          </a>
        ))
      }
    </div>
  </div>

  <div class="delivery-road" aria-hidden="true" data-delivery-road>
    <svg
      class="delivery-road-svg"
      viewBox="0 0 1200 280"
      preserveAspectRatio="xMidYMid meet"
      data-delivery-svg
    >
      <defs>
        <mask
          id="delivery-trail-mask"
          maskUnits="userSpaceOnUse"
          x="-80"
          y="0"
          width="1400"
          height="280"
        >
          <rect x="-80" width="1400" height="280" fill="black" />
          <path
            data-delivery-mask
            d={roadPath}
            fill="none"
            stroke="white"
            stroke-width="6"
            stroke-linecap="round"
            stroke-dasharray="0 99999"
          />
        </mask>
      </defs>
      <path
        class="delivery-road-path"
        data-delivery-path
        d={roadPath}
        fill="none"
        stroke="#d4af37"
        stroke-width="2.25"
        stroke-linecap="round"
        stroke-dasharray="10 12"
        mask="url(#delivery-trail-mask)"
      />
    </svg>

    <div class="delivery-car" data-delivery-car>
      <!-- top-down delivery car -->
      <svg viewBox="0 0 64 36" class="delivery-car-svg" fill="none">
        <rect x="4" y="8" width="40" height="20" rx="4" fill="#2f323a" stroke="#d4af37" stroke-width="1.5" />
        <rect x="44" y="10" width="16" height="16" rx="3" fill="#3a3d45" stroke="#d4af37" stroke-width="1.5" />
        <rect x="48" y="13" width="9" height="10" rx="1.5" fill="#8ec8e8" opacity="0.85" />
        <rect x="10" y="12" width="28" height="12" rx="2" fill="#d4af37" opacity="0.22" />
        <circle cx="14" cy="10" r="2.2" fill="#1c1f26" stroke="#f9e498" stroke-width="1" />
        <circle cx="14" cy="26" r="2.2" fill="#1c1f26" stroke="#f9e498" stroke-width="1" />
        <circle cx="50" cy="10" r="2.2" fill="#1c1f26" stroke="#f9e498" stroke-width="1" />
        <circle cx="50" cy="26" r="2.2" fill="#1c1f26" stroke="#f9e498" stroke-width="1" />
      </svg>
    </div>
  </div>
</section>

<style>
  .delivery-line {
    transition:
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.55s ease;
  }

  .delivery-road {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* Fixed geometry — same curve on mobile (overflows, never squash) */
  .delivery-road-svg {
    position: absolute;
    top: 50%;
    left: 50%;
    width: max(100%, 75rem);
    height: auto;
    aspect-ratio: 1200 / 280;
    max-height: none;
    transform: translate(-50%, -50%);
  }

  .delivery-road-path {
    opacity: 0.28;
  }

  .delivery-car {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 0;
    width: 3.75rem;
    opacity: 0;
    transform: translate(-50%, -50%);
    will-change: left, top, transform, opacity;
  }

  .delivery-car-svg {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 6px 12px rgb(0 0 0 / 0.45));
  }

  @media (prefers-reduced-motion: reduce) {
    .delivery-car {
      display: none;
    }

    .delivery-road-path {
      opacity: 0;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-delivery]');
  const road = document.querySelector<HTMLElement>('[data-delivery-road]');
  const path = document.querySelector<SVGPathElement>('[data-delivery-path]');
  const maskPath = document.querySelector<SVGPathElement>('[data-delivery-mask]');
  const car = document.querySelector<HTMLElement>('[data-delivery-car]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const placeCar = (t: number) => {
    if (!path || !car || !road) return;
    const svg = path.ownerSVGElement;
    if (!svg) return;

    const length = path.getTotalLength();
    const point = path.getPointAtLength(length * t);
    const ahead = path.getPointAtLength(Math.min(length, length * t + 2));
    const ctm = path.getScreenCTM();
    if (!ctm) return;

    const toScreen = (x: number, y: number) => {
      const pt = svg.createSVGPoint();
      pt.x = x;
      pt.y = y;
      return pt.matrixTransform(ctm);
    };

    const screen = toScreen(point.x, point.y);
    const screen2 = toScreen(ahead.x, ahead.y);
    const roadBox = road.getBoundingClientRect();
    const angle = (Math.atan2(screen2.y - screen.y, screen2.x - screen.x) * 180) / Math.PI;

    car.style.left = `${screen.x - roadBox.left}px`;
    car.style.top = `${screen.y - roadBox.top}px`;
    car.style.transform = `translate(-50%, -50%) rotate(${angle}deg)`;
  };

  const setTrail = (t: number) => {
    if (!maskPath) return;
    const length = maskPath.getTotalLength();
    const visibleLen = Math.max(0, length * t);
    maskPath.setAttribute('stroke-dasharray', `${visibleLen} ${length + 1}`);
    maskPath.style.strokeDasharray = `${visibleLen} ${length + 1}`;
    maskPath.style.strokeDashoffset = '0';
  };

  const clearRoad = () => {
    if (car) {
      car.style.opacity = '0';
    }
    if (path) path.style.opacity = '0';
    setTrail(0);
  };

  let rafId = 0;
  let runId = 0;

  const drive = () => {
    if (!section || !car || !path || !maskPath) return;

    const id = ++runId;
    cancelAnimationFrame(rafId);

    path.style.opacity = '0.28';
    setTrail(0);
    car.style.opacity = '1';
    placeCar(0);

    const duration = 4200;
    const start = performance.now();

    const tick = (now: number) => {
      if (id !== runId) return;

      const p = Math.min(1, (now - start) / duration);

      placeCar(p);
      setTrail(p);
      car.style.opacity = p < 0.06 ? String(p / 0.06) : p > 0.94 ? String((1 - p) / 0.06) : '1';

      if (p < 1) rafId = requestAnimationFrame(tick);
      else {
        car.style.opacity = '0';
        setTrail(1);
      }
    };

    rafId = requestAnimationFrame(tick);
  };

  const stopAndClear = () => {
    runId += 1;
    cancelAnimationFrame(rafId);
    clearRoad();
  };

  if (section && !reduceMotion) {
    clearRoad();

    const ENTER = 0.35;
    const EXIT = 0.22;
    let inView = false;

    const sync = () => {
      const rect = section.getBoundingClientRect();
      const vh = window.innerHeight || 1;
      const visiblePx = Math.min(rect.bottom, vh) - Math.max(rect.top, 0);
      const ratio = Math.max(0, visiblePx) / Math.min(rect.height, vh);
      const intersecting = visiblePx > 0;

      if (intersecting && ratio >= ENTER) {
        if (!inView) {
          inView = true;
          drive();
        }
        return;
      }

      if (inView && (!intersecting || ratio < EXIT)) {
        inView = false;
        stopAndClear();
      }
    };

    let ticking = false;
    const onScrollOrResize = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        sync();
      });
    };

    window.addEventListener('scroll', onScrollOrResize, { passive: true });
    window.addEventListener('resize', onScrollOrResize);
    sync();
  }
</script>
