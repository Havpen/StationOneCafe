---
import { withBase } from '../data/site';

const hookahItems = [
  {
    name: 'Classic',
    price: '25 BYN',
    description:
      'Классическая чаша на выбор табаков: мягкий дым, привычный вкус и спокойный вечер за столом.',
  },
  {
    name: 'Medium',
    price: '27 BYN',
    description:
      'Более насыщенный микс и плотный дым — для тех, кто хочет ярче ощутить аромат кальяна.',
  },
  {
    name: 'Premium',
    price: '33 BYN',
    description:
      'Премиальные табаки и сборка мастера: глубокий вкус, долгий прогрев и максимум удовольствия.',
  },
];
---

<section id="hookah" class="section-pad bg-navy border-y border-white/5" data-hookah>
  <div class="mx-auto max-w-7xl">
    <div class="section-heading section-heading-center from-smoke" style="--smoke-delay: 0.1s">
      <h2
        class="section-heading-gold font-display text-5xl font-bold leading-tight md:text-6xl lg:text-7xl"
      >
        Наши кальяны
      </h2>
      <span class="section-heading-rule" aria-hidden="true"></span>
    </div>

    <ul class="mt-12 grid gap-4 sm:grid-cols-3 sm:gap-5">
      {
        hookahItems.map((item, index) => (
          <li
            class="hookah-card from-smoke group relative overflow-hidden border border-white/12 bg-white/[0.03] p-6 sm:p-7"
            style={`--smoke-delay: ${0.15 + index * 0.1}s`}
          >
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="font-display text-2xl font-bold uppercase tracking-[0.18em] text-champagne md:text-3xl">
                {item.name}
              </h3>
              <span class="shrink-0 font-sans text-xl font-semibold text-gold md:text-2xl">
                {item.price}
              </span>
            </div>
            <span class="mt-4 block h-px w-full bg-gradient-to-r from-transparent via-gold/70 to-transparent" aria-hidden="true" />
            <p class="hookah-desc mt-5 text-sm font-light leading-relaxed text-silver md:text-base">
              {item.description}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .from-smoke {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.8s ease,
      transform 0.8s ease;
    transition-delay: var(--smoke-delay, 0s);
  }

  html.js-ready [data-hookah]:not(.is-visible) .from-smoke {
    opacity: 0;
    transform: translateY(1rem);
  }

  [data-hookah].is-visible .from-smoke {
    opacity: 1;
    transform: translateY(0);
    transition-delay: var(--smoke-delay, 0s);
  }

  .hookah-card {
    transition:
      border-color 0.35s ease,
      background-color 0.35s ease,
      transform 0.35s ease;
  }

  .hookah-card:hover,
  .hookah-card:focus-within {
    border-color: rgb(210 159 34 / 0.45);
    background: rgb(210 159 34 / 0.08);
    transform: translateY(-4px);
  }

  .hookah-desc {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    margin-top: 0;
    transition:
      max-height 0.45s ease,
      opacity 0.35s ease,
      margin-top 0.35s ease;
  }

  .hookah-card:hover .hookah-desc,
  .hookah-card:focus-within .hookah-desc {
    max-height: 8rem;
    opacity: 1;
    margin-top: 1.25rem;
  }

  @media (hover: none) {
    .hookah-desc {
      max-height: none;
      opacity: 1;
      margin-top: 1.25rem;
    }

    .hookah-card:hover {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .from-smoke,
    .hookah-card,
    .hookah-desc {
      transition: none;
    }

    .hookah-desc {
      max-height: none;
      opacity: 1;
      margin-top: 1.25rem;
    }
  }
</style>

<script>
  document.documentElement.classList.add('js-ready');
  const section = document.querySelector('[data-hookah]');
  if (section) {
    const setVisible = (isVisible: boolean) => section.classList.toggle('is-visible', isVisible);

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const ratio = entry.intersectionRatio;
            if (ratio >= 0.25) setVisible(true);
            else if (ratio < 0.1) setVisible(false);
          });
        },
        { threshold: [0, 0.1, 0.25, 0.5, 1] },
      );
      observer.observe(section);
    } else {
      setVisible(true);
    }
  }
</script>
