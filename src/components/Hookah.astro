---
const hookah = '/assets/hookah-square-enhanced.webp';

const prices = [
  { name: 'Classic', price: '25 BYN' },
  { name: 'Medium', price: '27 BYN' },
  { name: 'Premium', price: '33 BYN' },
];
---

<section id="hookah" class="relative min-h-[70vh] overflow-hidden md:min-h-[75vh]" data-hookah>
  <div class="absolute inset-0">
    <img
      src={hookah}
      alt="Кальяны в Station One Cafe, Гомель"
      class="hookah-image h-full w-full object-cover object-center"
      width="1200"
      height="1200"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-navy-deep/55"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-navy-deep/80 via-navy-deep/35 to-transparent"></div>
  </div>

  <div class="section-pad relative z-10 flex min-h-[70vh] items-center md:min-h-[75vh]">
    <div class="mx-auto w-full max-w-7xl text-center">
      <div class="section-heading section-heading-center from-smoke" style="--smoke-delay: 0.1s">
        <h2
          class="section-heading-gold font-display text-6xl font-semibold leading-tight md:text-7xl lg:text-8xl"
        >
          Наши кальяны в Гомеле
        </h2>
        <span class="section-heading-rule" aria-hidden="true"></span>
      </div>

      <ul class="mx-auto mt-10 flex w-full max-w-sm flex-col items-center space-y-5 md:mt-12">
        {
          prices.map((item) => (
            <li
              class="from-smoke grid w-full max-w-xs grid-cols-2 items-baseline gap-x-8 border-b-[3px] border-white/10 pb-3 md:max-w-sm md:gap-x-12"
              style="--smoke-delay: 0.1s"
            >
              <span class="justify-self-start text-left text-base font-medium uppercase tracking-[0.22em] text-champagne md:text-lg">
                {item.name}
              </span>
              <span class="justify-self-start text-left font-sans text-2xl font-semibold tracking-normal text-gold md:text-3xl">
                {item.price}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .hookah-image {
    opacity: 1;
    transform: scale(1);
    transition:
      opacity 0.85s ease,
      transform 0.85s ease;
    transition-delay: 0.05s;
  }

  html.js-ready [data-hookah]:not(.is-visible) .hookah-image {
    opacity: 0;
    transform: scale(1.04);
  }

  [data-hookah].is-visible .hookah-image {
    opacity: 1;
    transform: scale(1);
    transition-delay: 0.05s;
  }

  [data-hookah]:not(.is-visible) .hookah-image {
    transition-delay: 0.35s;
  }

  .from-smoke {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.8s ease,
      transform 0.8s ease;
    transition-delay: var(--smoke-delay, 0s);
  }

  html.js-ready [data-hookah]:not(.is-visible) .from-smoke {
    opacity: 0;
    transform: translateY(1rem);
  }

  [data-hookah].is-visible .from-smoke {
    opacity: 1;
    transform: translateY(0);
    transition-delay: var(--smoke-delay, 0s);
  }

  [data-hookah]:not(.is-visible) .from-smoke {
    transition-delay: 0s;
  }

  html.js-ready [data-hookah]:not(.is-visible) li.from-smoke {
    transform: translateY(0.85rem);
  }

  [data-hookah].is-visible li.from-smoke {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .hookah-image,
    .from-smoke,
    [data-hookah].is-visible .hookah-image,
    [data-hookah].is-visible .from-smoke,
    html.js-ready [data-hookah]:not(.is-visible) .hookah-image,
    html.js-ready [data-hookah]:not(.is-visible) .from-smoke {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  document.documentElement.classList.add('js-ready');
  const section = document.querySelector('[data-hookah]');
  if (section) {
    const setVisible = (isVisible: boolean) => section.classList.toggle('is-visible', isVisible);

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const ratio = entry.intersectionRatio;
            if (ratio >= 2 / 3) {
              setVisible(true);
            } else if (ratio < 1 / 3) {
              setVisible(false);
            }
          });
        },
        { threshold: [0, 1 / 3, 0.5, 2 / 3, 1] },
      );
      observer.observe(section);
    } else {
      setVisible(true);
    }
  }
</script>
