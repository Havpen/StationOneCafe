---
import { withBase, site } from '../data/site';

const year = new Date().getFullYear();
const logo = withBase('/logo.webp');

const links = [
  { id: 'kitchen', label: 'Кухня' },
  { id: 'gallery', label: 'Галерея' },
  { id: 'hookah', label: 'Кальяны' },
  { id: 'delivery', label: 'Доставка' },
  { id: 'reviews', label: 'Отзывы' },
  { id: 'map', label: 'Как нас найти' },
  { id: 'contacts', label: 'Контакты' },
];

const socials = [
  {
    href: site.social.instagram,
    label: '@station_one_gomel',
    name: 'Instagram',
  },
  {
    href: site.social.yandexMaps,
    label: 'Яндекс Карты',
    name: 'Яндекс Карты',
  },
  {
    href: site.social.yandexEda,
    label: 'Яндекс Еда',
    name: 'Яндекс Еда',
  },
  {
    href: site.social.justEat,
    label: 'Just Eat',
    name: 'Just Eat',
  },
];
---

<footer class="border-t border-white/5 bg-navy">
  <div
    class="mx-auto flex max-w-7xl flex-col gap-8 px-5 py-8 md:flex-row md:items-start md:justify-between md:gap-12 md:px-10 md:py-10"
  >
    <div class="order-1 hidden md:block">
      <button type="button" class="inline-block border-0 bg-transparent p-0" data-scroll-to="top" aria-label="Наверх">
        <img
          src={logo}
          alt="Station One Cafe"
          class="h-20 w-auto"
          width="128"
          height="128"
          loading="lazy"
          decoding="async"
        />
      </button>
    </div>

    <nav
      class="order-1 flex flex-wrap gap-x-6 gap-y-3 text-sm text-silver md:order-2 md:max-w-md md:justify-center"
      aria-label="Навигация"
    >
      {
        links.map((link) => (
          <button
            type="button"
            class="cursor-pointer border-0 bg-transparent p-0 text-silver transition hover:text-champagne"
            data-scroll-to={link.id}
          >
            {link.label}
          </button>
        ))
      }
    </nav>

    <div
      class="order-2 flex items-start justify-between gap-4 text-sm text-silver md:order-3 md:flex-col md:items-end md:justify-start md:gap-3"
    >
      <div class="flex flex-col gap-2">
        <a href={`tel:${site.phone}`} class="text-gold transition hover:text-champagne">
          {site.phoneDisplay}
        </a>
        <div class="flex flex-col gap-1.5">
          {
            socials.map((item) => (
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class="transition hover:text-champagne"
              >
                {item.label}
              </a>
            ))
          }
        </div>
        <p class="mt-1 text-xs text-silver/60">© {year} Station One Cafe</p>
      </div>

      <div class="shrink-0 text-right md:hidden">
        <button type="button" class="inline-block border-0 bg-transparent p-0" data-scroll-to="top" aria-label="Наверх">
          <img
            src={logo}
            alt="Station One Cafe"
            class="h-16 w-auto"
            width="128"
            height="128"
            loading="lazy"
            decoding="async"
          />
        </button>
      </div>
    </div>
  </div>

  <div class="flex w-full justify-center px-5 pb-8 md:px-10 md:pb-10">
    <p class="text-center text-xs tracking-wide text-silver/45">
      made by SkarbSoft
    </p>
  </div>
</footer>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  document.querySelectorAll<HTMLElement>('footer [data-scroll-to]').forEach((el) => {
    el.addEventListener('click', () => {
      const id = el.getAttribute('data-scroll-to');
      if (!id) return;
      const target = document.getElementById(id);
      if (!target) return;
      const headerH = header?.offsetHeight || 72;
      const y = Math.max(0, window.scrollY + target.getBoundingClientRect().top - headerH - 12);
      window.scrollTo({ top: y, behavior: 'smooth' });
    });
  });
</script>
