---
import { site, withBase } from '../data/site';

const year = new Date().getFullYear();
const logo = withBase('/logo.webp');

const links = [
  { id: 'kitchen', label: 'Кухня' },
  { id: 'gallery', label: 'Галерея' },
  { id: 'hookah', label: 'Кальяны' },
  { id: 'delivery', label: 'Доставка' },
  { id: 'reviews', label: 'Отзывы' },
  { id: 'map', label: 'Как нас найти' },
  { id: 'contacts', label: 'Контакты' },
];

const socials = [
  {
    label: 'Instagram',
    href: site.social.instagram,
    icon: 'instagram' as const,
  },
  {
    label: 'Яндекс Карты',
    href: site.social.yandexOrg,
    icon: 'yandex' as const,
  },
  {
    label: 'Яндекс Еда',
    href: site.social.yandexEda,
    icon: 'yandex' as const,
  },
  {
    label: 'Just Eat',
    href: site.social.justEat,
    icon: 'justeat' as const,
  },
];
---

<footer class="border-t border-white/5 bg-navy-deep">
  <div
    class="mx-auto flex max-w-7xl flex-col gap-6 px-5 py-8 md:flex-row md:items-start md:justify-between md:gap-12 md:px-10 md:py-10"
  >
    <div class="order-1 hidden md:order-1 md:block">
      <button type="button" class="inline-block border-0 bg-transparent p-0" data-scroll-to="top" aria-label="Наверх">
        <img
          src={logo}
          alt="Station One Cafe"
          class="h-20 w-auto"
          width="128"
          height="128"
          loading="lazy"
          decoding="async"
        />
      </button>
    </div>

    <nav
      class="order-1 flex flex-wrap justify-center gap-x-6 gap-y-3 text-sm text-silver md:order-2 md:max-w-md"
      aria-label="Навигация"
    >
      {
        links.map((link) => (
          <button
            type="button"
            class="cursor-pointer border-0 bg-transparent p-0 text-silver transition hover:text-champagne"
            data-scroll-to={link.id}
          >
            {link.label}
          </button>
        ))
      }
    </nav>

    <div
      class="order-2 flex items-start justify-between gap-4 text-sm text-silver md:order-3 md:flex-col md:items-end md:justify-start md:gap-3"
    >
      <div class="flex flex-col gap-3 md:items-end">
        <a href={`tel:${site.phone}`} class="text-gold transition hover:text-champagne">
          {site.phoneDisplay}
        </a>

        <div class="flex flex-col gap-2 md:items-end" aria-label="Соцсети и сервисы">
          {
            socials.map((item) => (
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 transition hover:text-champagne"
              >
                {item.icon === 'instagram' ? (
                  <svg
                    class="size-4 shrink-0"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                    <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
                  </svg>
                ) : (
                  <svg
                    class="size-4 shrink-0"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                  </svg>
                )}
                {item.label}
              </a>
            ))
          }
        </div>

        <p class="text-xs text-silver/60">© {year} Station One Cafe</p>
      </div>

      <div class="shrink-0 text-right md:hidden">
        <button type="button" class="inline-block border-0 bg-transparent p-0" data-scroll-to="top" aria-label="Наверх">
          <img
            src={logo}
            alt="Station One Cafe"
            class="h-16 w-auto"
            width="128"
            height="128"
            loading="lazy"
            decoding="async"
          />
        </button>
      </div>
    </div>
  </div>

  <div class="flex w-full justify-center px-5 pb-8 md:px-10 md:pb-10">
    <p class="text-center text-xs tracking-wide text-silver/45">
      made by SkarbSoft
    </p>
  </div>
</footer>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  document.querySelectorAll<HTMLElement>('footer [data-scroll-to]').forEach((el) => {
    el.addEventListener('click', () => {
      const id = el.getAttribute('data-scroll-to');
      if (!id) return;
      const target = document.getElementById(id);
      if (!target) return;
      const headerH = header?.offsetHeight || 72;
      const y = Math.max(0, window.scrollY + target.getBoundingClientRect().top - headerH - 12);
      window.scrollTo({ top: y, behavior: 'smooth' });
    });
  });
</script>
