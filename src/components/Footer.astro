---
const phone = '+375333335233';
const phoneDisplay = '+375 33 333-52-33';
const year = new Date().getFullYear();

const links = [
  { href: '#kitchen', label: 'Кухня' },
  { href: '#gallery', label: 'Галерея' },
  { href: '#hookah', label: 'Кальяны' },
  { href: '#delivery', label: 'Доставка' },
  { href: '#reviews', label: 'Отзывы' },
  { href: '#map', label: 'Как нас найти' },
  { href: '#contacts', label: 'Контакты' },
];
---

<footer class="border-t border-white/5 bg-navy-deep">
  <div
    class="mx-auto flex max-w-7xl flex-col gap-6 px-5 py-8 md:flex-row md:items-start md:justify-between md:gap-12 md:px-10 md:py-10"
  >
    <div class="order-1 hidden md:order-1 md:block">
      <a href="#top" class="inline-block">
        <img
          src="/logo.webp"
          alt="Station One Cafe"
          class="h-20 w-auto"
          width="128"
          height="128"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>

    <nav
      class="order-1 flex flex-wrap gap-x-6 gap-y-3 text-sm text-silver md:order-2 md:max-w-md md:justify-center"
      aria-label="Навигация"
    >
      {
        links.map((link) => (
          <a href={link.href} class="transition hover:text-champagne">
            {link.label}
          </a>
        ))
      }
    </nav>

    <div
      class="order-2 flex items-start justify-between gap-4 text-sm text-silver md:order-3 md:flex-col md:items-end md:justify-start md:gap-2"
    >
      <div class="flex flex-col gap-2">
        <a href={`tel:${phone}`} class="text-gold transition hover:text-champagne">
          {phoneDisplay}
        </a>
        <a
          href="https://www.instagram.com/station_one_gomel/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 transition hover:text-champagne"
        >
          <svg
            class="size-4 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
          </svg>
          @station_one_gomel
        </a>
        <p class="text-xs text-silver/60">© {year} Station One Cafe</p>
      </div>

      <div class="shrink-0 text-right md:hidden">
        <a href="#top" class="inline-block">
          <img
            src="/logo.webp"
            alt="Station One Cafe"
            class="h-16 w-auto"
            width="128"
            height="128"
            loading="lazy"
            decoding="async"
          />
        </a>
      </div>
    </div>
  </div>

  <div class="flex w-full justify-center px-5 pb-8 md:px-10 md:pb-10">
    <p class="text-center text-xs tracking-wide text-silver/45">
      made by SkarbSoft
    </p>
  </div>
</footer>
