---
import { withBase, site } from '../data/site';

const bg = withBase('/assets/621465960_18067678844550093_6426370961459551137_n.webp');
---

<section id="contacts" class="relative overflow-hidden">
  <div class="absolute inset-0">
    <img
      src={bg}
      alt="Интерьер Station One Cafe для брони стола"
      class="h-full w-full object-cover object-center"
      width="1920"
      height="1080"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-navy/88"></div>
    <div
      class="absolute inset-0 bg-gradient-to-br from-gold-deep/20 via-transparent to-transparent"
    >
    </div>
  </div>

  <div class="section-pad relative z-10 mx-auto flex max-w-7xl flex-col items-center text-center">
    <p class="text-xs font-medium uppercase tracking-[0.3em] text-gold">Бронь</p>
    <div class="section-heading section-heading-center mt-4">
      <h2
        class="section-heading-gold font-display text-4xl font-bold leading-tight md:text-6xl"
      >
        Забронируйте стол одним звонком
      </h2>
      <span class="section-heading-rule" aria-hidden="true"></span>
    </div>
    <p class="mt-5 max-w-lg text-base font-light leading-relaxed text-silver">
      Назовите <span class="text-accent">дату</span>,
      <span class="text-accent">время</span> и
      <span class="text-accent">количество гостей</span> — администратор подтвердит бронь.
    </p>

    <a href={`tel:${site.phone}`} class="book-btn book-btn-lg mt-10">
      {site.phoneDisplay}
      <svg
        class="size-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path
          d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"
        ></path>
      </svg>
    </a>
  </div>
</section>
