---
import { withBase } from '../data/site';

const phone = '+375333335233';
const hero = withBase('/assets/hero.webp');
---

<section id="top" class="relative min-h-[100svh] overflow-hidden" data-hero>
  <div class="absolute inset-0">
    <img
      src={hero}
      alt="Интерьер Station One Cafe"
      class="animate-ken h-full w-full object-cover object-center"
      width="1920"
      height="1080"
      decoding="async"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-navy-deep/70"></div>
    <div
      class="absolute inset-0 bg-gradient-to-t from-navy-deep via-navy/50 to-navy/40"
    >
    </div>
  </div>

  <div class="hero-shell">
    <div class="hero-stack">
      <img
        src={withBase('/assets/hero-flourish.webp')}
        alt=""
        class="hero-flourish hero-reveal"
        style="--hero-delay: 0.05s"
        width="480"
        height="80"
        aria-hidden="true"
      />

      <h1
        class="hero-title hero-title-gold hero-reveal font-display leading-[0.95] font-semibold tracking-tight"
        style="--hero-delay: 0.2s"
      >
        Station One<span class="sr-only"> Cafe — кафе и ресторан в Гомеле</span>
      </h1>

      <span
        class="hero-rule hero-reveal"
        style="--hero-delay: 0.35s"
        aria-hidden="true"
      ></span>

      <span
        class="hero-cafe hero-title-gold hero-reveal font-display text-[clamp(1.4375rem,5vw,3.125rem)] font-medium uppercase"
        style="--hero-delay: 0.45s"
      >
        Cafe
      </span>

      <div
        class="hero-copy hero-reveal"
        style="--hero-delay: 0.6s"
      >
        <p class="hero-copy-lead font-accent">
          Уютное пространство для встреч
        </p>
        <p class="hero-copy-sub">
          Ужин и вечер с бокалом вина и кальяном.
        </p>
      </div>

      <a
        href={`tel:${phone}`}
        data-hero-book
        class="hero-reveal book-btn book-btn-lg !px-11 !py-5 !text-lg shadow-[0_0_0_1px_rgba(212,175,55,0.35)]"
        style="--hero-delay: 0.75s"
      >
        Забронировать стол
      </a>
    </div>
  </div>
</section>

<style>
  .hero-shell {
    position: relative;
    z-index: 10;
    display: grid;
    min-height: 100svh;
    place-items: center;
    padding: 7rem 1.25rem 4rem;
  }

  @media (min-width: 768px) {
    .hero-shell {
      padding: 6rem 2.5rem 6rem;
    }
  }

  .hero-stack {
    display: grid;
    width: 100%;
    max-width: 42rem;
    justify-items: center;
    text-align: center;
    margin-inline: auto;
    box-sizing: border-box;
  }

  .hero-title {
    max-width: 100%;
    font-size: clamp(3.75rem, 16.5vw, 8.125rem);
  }

  .hero-flourish {
    width: min(100%, 32rem);
    max-width: 100%;
    margin-bottom: -0.75rem;
    mix-blend-mode: screen;
  }

  .hero-rule {
    display: block;
    width: 100%;
    height: 1px;
    margin-top: 1.25rem;
    background: linear-gradient(
      90deg,
      transparent 0%,
      #b08945 12%,
      #f4d38a 50%,
      #b08945 88%,
      transparent 100%
    );
  }

  .hero-cafe {
    margin-top: 1rem;
    letter-spacing: 0.42em;
    padding-left: 0.42em;
  }

  .hero-copy {
    max-width: min(100%, 28rem);
    margin-top: 2rem;
    padding-inline: 0.25rem;
    text-align: center;
  }

  .hero-copy-lead {
    margin: 0;
    font-size: clamp(1.15rem, 3.8vw, 1.55rem);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0.02em;
    color: #f9e498;
  }

  .hero-copy-sub {
    margin: 0.55rem 0 0;
    font-size: clamp(0.95rem, 2.8vw, 1.125rem);
    font-weight: 300;
    line-height: 1.5;
    color: #a6a9ad;
  }

  .hero-stack > .book-btn {
    margin-top: 3rem;
    max-width: 100%;
    box-sizing: border-box;
  }

  .hero-title-gold {
    background-image: linear-gradient(
      180deg,
      #fce8b3 0%,
      #f4d38a 42%,
      #d29f22 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-reveal {
    opacity: 0;
    transform: translateY(1.25rem);
    animation: hero-reveal 0.95s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--hero-delay, 0s);
  }

  @keyframes hero-reveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-reveal {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
