---
import { withBase, site } from '../data/site';

const instagram = site.social.instagram;

const photos = [
  '/assets/gallery-01.webp',
  '/assets/gallery-02.webp',
  '/assets/gallery-03.webp',
  '/assets/gallery-04.webp',
  '/assets/gallery-05.webp',
  '/assets/gallery-06.webp',
  '/assets/gallery-07.webp',
  '/assets/gallery-08.webp',
  '/assets/gallery-09.webp',
  '/assets/gallery-10.webp',
  '/assets/gallery-11.webp',
  '/assets/gallery-12.webp',
  '/assets/gallery-13.webp',
  '/assets/gallery-14.webp',
  '/assets/gallery-15.webp',
].map((src) => withBase(src));

const strip = [...photos, ...photos];
---

<section id="gallery" class="relative overflow-hidden bg-navy py-10 md:py-14" data-gallery>
  <div class="relative mx-auto mb-6 max-w-7xl px-5 md:mb-8 md:px-10 lg:px-16">
    <div class="section-heading section-heading-center">
      <h2
        class="section-heading-gold font-display text-4xl font-semibold leading-tight md:text-5xl lg:text-6xl"
      >
        Галерея
      </h2>
      <span class="section-heading-rule" aria-hidden="true"></span>
    </div>
  </div>

  <div class="gallery-marquee" data-gallery-marquee aria-label="Фотографии кафе">
    <div class="gallery-track" data-gallery-track>
      {
        strip.map((src, index) => (
          <a
            href={instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="gallery-item"
            aria-label={
              index < photos.length
                ? `Station One Cafe — фото ${index + 1}, открыть Instagram`
                : 'Открыть Instagram Station One'
            }
            tabindex={index >= photos.length ? -1 : undefined}
            aria-hidden={index >= photos.length ? 'true' : undefined}
          >
            <img
              src={src}
              alt={index < photos.length ? `Station One Cafe — фото ${index + 1}` : ''}
              width="640"
              height="853"
              loading="lazy"
              decoding="async"
              draggable="false"
            />
          </a>
        ))
      }
    </div>
  </div>

  <div class="relative mx-auto mt-6 max-w-7xl px-5 text-center md:mt-8 md:px-10 lg:px-16">
    <a
      href={instagram}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 font-body text-sm tracking-wide text-silver transition hover:text-champagne md:text-base"
    >
      наш инстаграм
    </a>
  </div>
</section>

<style>
  /* Как полоска-лента: overflow hidden + translate, без скроллбара */
  .gallery-marquee {
    overflow: hidden;
    width: 100%;
    cursor: grab;
    touch-action: pan-y;
    mask-image: linear-gradient(
      90deg,
      transparent 0%,
      #000 3%,
      #000 97%,
      transparent 100%
    );
  }

  .gallery-marquee.is-dragging {
    cursor: grabbing;
  }

  .gallery-track {
    display: flex;
    width: max-content;
    gap: 0.85rem;
    padding-block: 0.25rem;
    padding-inline: 1.25rem;
    user-select: none;
    will-change: transform;
  }

  .gallery-item {
    margin: 0;
    flex: 0 0 auto;
    width: min(42vw, 16.5rem);
    overflow: hidden;
    background: rgb(22 23 26 / 0.45);
    display: block;
    color: inherit;
    text-decoration: none;
    cursor: inherit;
  }

  @media (min-width: 768px) {
    .gallery-item {
      width: 18.5rem;
    }

    .gallery-track {
      gap: 1rem;
      padding-inline: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .gallery-item {
      width: 20rem;
    }
  }

  .gallery-item img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    height: auto;
    object-fit: cover;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-track {
      transform: none !important;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-gallery-marquee]');
  const track = document.querySelector<HTMLElement>('[data-gallery-track]');
  if (!root || !track) {
    // no-op
  } else {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const speed = 0.45;
    let x = 0;
    let paused = false;
    let dragging = false;
    let moved = 0;
    let startX = 0;
    let startOffset = 0;
    let frame = 0;

    const half = () => track.scrollWidth / 2;

    const apply = () => {
      const w = half();
      if (w > 0) {
        while (x <= -w) x += w;
        while (x > 0) x -= w;
      }
      track.style.transform = `translate3d(${x}px, 0, 0)`;
    };

    const tick = () => {
      if (!paused && !dragging && !reduceMotion) {
        x -= speed;
        apply();
      }
      frame = requestAnimationFrame(tick);
    };

    if (!reduceMotion) frame = requestAnimationFrame(tick);

    root.addEventListener('mouseenter', () => {
      paused = true;
    });

    root.addEventListener('mouseleave', () => {
      paused = false;
      dragging = false;
      root.classList.remove('is-dragging');
    });

    const onDown = (clientX: number) => {
      dragging = true;
      moved = 0;
      startX = clientX;
      startOffset = x;
      root.classList.add('is-dragging');
    };

    const onMove = (clientX: number) => {
      if (!dragging) return;
      const dx = clientX - startX;
      moved = Math.max(moved, Math.abs(dx));
      x = startOffset + dx;
      apply();
    };

    const onUp = () => {
      if (!dragging) return;
      dragging = false;
      root.classList.remove('is-dragging');
      paused = root.matches(':hover');
    };

    root.addEventListener('mousedown', (e) => {
      if (e.button !== 0) return;
      e.preventDefault();
      onDown(e.clientX);
    });

    window.addEventListener('mousemove', (e) => onMove(e.clientX));
    window.addEventListener('mouseup', onUp);

    root.addEventListener(
      'touchstart',
      (e) => {
        if (e.touches.length !== 1) return;
        onDown(e.touches[0].clientX);
      },
      { passive: true },
    );

    root.addEventListener(
      'touchmove',
      (e) => {
        if (!dragging || e.touches.length !== 1) return;
        onMove(e.touches[0].clientX);
      },
      { passive: true },
    );

    root.addEventListener('touchend', onUp);
    root.addEventListener('touchcancel', onUp);

    // клик = Instagram, если не тянули
    root.addEventListener(
      'click',
      (e) => {
        if (moved < 8) return;
        e.preventDefault();
        e.stopPropagation();
      },
      true,
    );

    window.addEventListener('beforeunload', () => cancelAnimationFrame(frame));
  }
</script>
