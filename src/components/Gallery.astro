---
import { withBase, site } from '../data/site';

const instagram = site.social.instagram;

const photos = [
  '/assets/gallery-01.webp',
  '/assets/gallery-02.webp',
  '/assets/gallery-03.webp',
  '/assets/gallery-04.webp',
  '/assets/gallery-05.webp',
  '/assets/gallery-06.webp',
  '/assets/gallery-07.webp',
  '/assets/gallery-08.webp',
  '/assets/gallery-09.webp',
  '/assets/gallery-10.webp',
  '/assets/gallery-11.webp',
  '/assets/gallery-12.webp',
  '/assets/gallery-13.webp',
  '/assets/gallery-14.webp',
  '/assets/gallery-15.webp',
].map((src) => withBase(src));

const strip = [...photos, ...photos];
---

<section id="gallery" class="relative overflow-hidden bg-navy py-10 md:py-14" data-gallery>
  <div class="relative mx-auto mb-6 max-w-7xl px-5 md:mb-8 md:px-10 lg:px-16">
    <div class="section-heading section-heading-center">
      <h2
        class="section-heading-gold font-display text-4xl font-semibold leading-tight md:text-5xl lg:text-6xl"
      >
        Галерея
      </h2>
      <span class="section-heading-rule" aria-hidden="true"></span>
    </div>
  </div>

  <div class="gallery-marquee" data-gallery-marquee aria-label="Фотографии кафе">
    <div class="gallery-track" data-gallery-track>
      {
        strip.map((src, index) => (
          <a
            href={instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="gallery-item"
            data-gallery-link
            aria-label={
              index < photos.length
                ? `Station One Cafe — фото ${index + 1}, открыть Instagram`
                : 'Открыть Instagram Station One'
            }
            tabindex={index >= photos.length ? -1 : undefined}
            aria-hidden={index >= photos.length ? 'true' : undefined}
          >
            <img
              src={src}
              alt={index < photos.length ? `Station One Cafe — фото ${index + 1}` : ''}
              width="640"
              height="853"
              loading="lazy"
              decoding="async"
              draggable="false"
            />
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .gallery-marquee {
    overflow-x: auto;
    overflow-y: hidden;
    width: 100%;
    cursor: grab;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-x;
    overscroll-behavior-x: contain;
    mask-image: linear-gradient(
      90deg,
      transparent 0%,
      #000 3%,
      #000 97%,
      transparent 100%
    );
  }

  .gallery-marquee::-webkit-scrollbar {
    display: none;
  }

  .gallery-marquee.is-dragging {
    cursor: grabbing;
  }

  .gallery-track {
    display: flex;
    width: max-content;
    gap: 0.85rem;
    padding-block: 0.25rem;
    padding-inline: 1.25rem;
    user-select: none;
  }

  .gallery-item {
    margin: 0;
    flex: 0 0 auto;
    width: min(42vw, 16.5rem);
    overflow: hidden;
    background: rgb(22 23 26 / 0.45);
    display: block;
    color: inherit;
    text-decoration: none;
    cursor: grab;
  }

  .gallery-marquee.is-dragging .gallery-item {
    cursor: grabbing;
  }

  @media (min-width: 768px) {
    .gallery-item {
      width: 18.5rem;
    }

    .gallery-track {
      gap: 1rem;
      padding-inline: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .gallery-item {
      width: 20rem;
    }
  }

  .gallery-item img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    height: auto;
    object-fit: cover;
    pointer-events: none;
  }
</style>

<script>
  const marquee = document.querySelector<HTMLElement>('[data-gallery-marquee]');
  if (!marquee) {
    // no-op
  } else {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const speed = 0.4125; // was 0.55, −25%
    let paused = false;
    let frame = 0;

    // mouse drag state
    let down = false;
    let dragged = false;
    let startX = 0;
    let startScroll = 0;

    const loopPoint = () => marquee.scrollWidth / 2;

    const wrap = () => {
      const half = loopPoint();
      if (half <= 0) return;
      while (marquee.scrollLeft >= half) marquee.scrollLeft -= half;
      while (marquee.scrollLeft < 0) marquee.scrollLeft += half;
    };

    const autoplay = () => {
      if (!paused && !down && !reduceMotion) {
        marquee.scrollLeft += speed;
        wrap();
      }
      frame = requestAnimationFrame(autoplay);
    };

    if (!reduceMotion) frame = requestAnimationFrame(autoplay);

    marquee.addEventListener('mouseenter', () => {
      paused = true;
    });

    marquee.addEventListener('mouseleave', () => {
      paused = false;
      down = false;
      marquee.classList.remove('is-dragging');
    });

    // Desktop: click-drag left/right
    marquee.addEventListener('mousedown', (event) => {
      if (event.button !== 0) return;
      down = true;
      dragged = false;
      paused = true;
      startX = event.clientX;
      startScroll = marquee.scrollLeft;
      marquee.classList.add('is-dragging');
    });

    window.addEventListener('mousemove', (event) => {
      if (!down) return;
      const dx = event.clientX - startX;
      if (Math.abs(dx) > 5) dragged = true;
      marquee.scrollLeft = startScroll - dx;
      wrap();
    });

    window.addEventListener('mouseup', () => {
      if (!down) return;
      down = false;
      marquee.classList.remove('is-dragging');
      // stay paused while cursor is over gallery
      paused = marquee.matches(':hover');
    });

    // Touch: native horizontal swipe; pause while touching
    marquee.addEventListener(
      'touchstart',
      () => {
        paused = true;
      },
      { passive: true },
    );

    marquee.addEventListener(
      'touchend',
      () => {
        window.setTimeout(() => {
          if (!marquee.matches(':hover')) paused = false;
        }, 700);
      },
      { passive: true },
    );

    marquee.addEventListener(
      'scroll',
      () => {
        wrap();
      },
      { passive: true },
    );

    // Click opens Instagram only if it wasn't a drag
    marquee.addEventListener(
      'click',
      (event) => {
        if (!dragged) return;
        event.preventDefault();
        event.stopPropagation();
      },
      true,
    );

    window.addEventListener('beforeunload', () => cancelAnimationFrame(frame));
  }
</script>
