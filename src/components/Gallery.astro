---
import { withBase, site } from '../data/site';

const instagram = site.social.instagram;

const photos = [
  '/assets/gallery-01.webp',
  '/assets/gallery-02.webp',
  '/assets/gallery-03.webp',
  '/assets/gallery-04.webp',
  '/assets/gallery-05.webp',
  '/assets/gallery-06.webp',
  '/assets/gallery-07.webp',
  '/assets/gallery-08.webp',
  '/assets/gallery-09.webp',
  '/assets/gallery-10.webp',
  '/assets/gallery-11.webp',
  '/assets/gallery-12.webp',
  '/assets/gallery-13.webp',
  '/assets/gallery-14.webp',
  '/assets/gallery-15.webp',
].map((src) => withBase(src));

const strip = [...photos, ...photos];
---

<section id="gallery" class="relative overflow-hidden bg-navy py-10 md:py-14" data-gallery>
  <div class="relative mx-auto mb-6 max-w-7xl px-5 md:mb-8 md:px-10 lg:px-16">
    <div class="section-heading section-heading-center">
      <h2
        class="section-heading-gold font-display text-4xl font-semibold leading-tight md:text-5xl lg:text-6xl"
      >
        Галерея
      </h2>
      <span class="section-heading-rule" aria-hidden="true"></span>
    </div>
  </div>

  <div class="gallery-marquee" data-gallery-marquee aria-label="Фотографии кафе">
    <div class="gallery-track" data-gallery-track>
      {
        strip.map((src, index) => (
          <a
            href={instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="gallery-item"
            data-gallery-link
            aria-label={
              index < photos.length
                ? `Station One Cafe — фото ${index + 1}, открыть Instagram`
                : 'Открыть Instagram Station One'
            }
            tabindex={index >= photos.length ? -1 : undefined}
            aria-hidden={index >= photos.length ? 'true' : undefined}
          >
            <img
              src={src}
              alt={index < photos.length ? `Station One Cafe — фото ${index + 1}` : ''}
              width="640"
              height="853"
              loading="lazy"
              decoding="async"
              draggable="false"
            />
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .gallery-marquee {
    overflow-x: auto;
    overflow-y: hidden;
    width: 100%;
    cursor: grab;
    scrollbar-width: thin;
    scrollbar-color: rgb(210 159 34 / 0.45) transparent;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-x;
    overscroll-behavior-x: contain;
    mask-image: linear-gradient(
      90deg,
      transparent 0%,
      #000 3%,
      #000 97%,
      transparent 100%
    );
  }

  .gallery-marquee.is-dragging {
    cursor: grabbing;
    scroll-behavior: auto;
  }

  .gallery-track {
    display: flex;
    width: max-content;
    gap: 0.85rem;
    padding-block: 0.25rem;
    padding-inline: 1.25rem;
    user-select: none;
  }

  .gallery-item {
    margin: 0;
    flex: 0 0 auto;
    width: min(42vw, 16.5rem);
    overflow: hidden;
    background: rgb(22 23 26 / 0.45);
    display: block;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    transition: opacity 0.25s ease;
  }

  .gallery-item:hover {
    opacity: 0.92;
  }

  @media (min-width: 768px) {
    .gallery-item {
      width: 18.5rem;
    }

    .gallery-track {
      gap: 1rem;
      padding-inline: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .gallery-item {
      width: 20rem;
    }
  }

  .gallery-item img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    height: auto;
    object-fit: cover;
    pointer-events: none;
  }
</style>

<script>
  const marquee = document.querySelector<HTMLElement>('[data-gallery-marquee]');
  if (marquee) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let paused = false;
    let dragging = false;
    let dragActive = false;
    let suppressClick = false;
    let startX = 0;
    let startScroll = 0;
    let pointerId: number | null = null;
    let frame = 0;
    let resumeTimer = 0;
    const speed = 0.55;
    const dragThreshold = 8;

    const halfWidth = () => marquee.scrollWidth / 2;

    const normalizeLoop = () => {
      const half = halfWidth();
      if (half <= 0) return;
      if (marquee.scrollLeft >= half) marquee.scrollLeft -= half;
      if (marquee.scrollLeft < 0) marquee.scrollLeft += half;
    };

    const tick = () => {
      if (!paused && !dragging && !reduceMotion) {
        marquee.scrollLeft += speed;
        normalizeLoop();
      }
      frame = requestAnimationFrame(tick);
    };

    if (!reduceMotion) frame = requestAnimationFrame(tick);

    const pause = () => {
      paused = true;
      window.clearTimeout(resumeTimer);
    };

    const scheduleResume = () => {
      window.clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(() => {
        if (!dragging && !marquee.matches(':hover')) paused = false;
      }, 900);
    };

    marquee.addEventListener('mouseenter', pause);
    marquee.addEventListener('mouseleave', () => {
      if (!dragging) {
        paused = false;
      }
    });

    // Trackpad / mouse wheel → horizontal scroll
    marquee.addEventListener(
      'wheel',
      (event) => {
        const dx = event.deltaX;
        const dy = event.deltaY;
        if (Math.abs(dx) < 1 && Math.abs(dy) < 1) return;

        pause();
        // Prefer vertical wheel as horizontal browse (common for carousels)
        if (Math.abs(dy) >= Math.abs(dx)) {
          event.preventDefault();
          marquee.scrollLeft += dy;
        }
        normalizeLoop();
        scheduleResume();
      },
      { passive: false },
    );

    marquee.addEventListener('scroll', () => {
      normalizeLoop();
    }, { passive: true });

    marquee.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      // Touch: let native pan-x scroll work; only pause autoplay
      if (event.pointerType === 'touch') {
        pause();
        return;
      }

      dragging = true;
      dragActive = false;
      suppressClick = false;
      startX = event.clientX;
      startScroll = marquee.scrollLeft;
      pointerId = event.pointerId;
      pause();
    });

    marquee.addEventListener('pointermove', (event) => {
      if (!dragging || event.pointerId !== pointerId) return;
      const dx = event.clientX - startX;

      if (!dragActive) {
        if (Math.abs(dx) < dragThreshold) return;
        dragActive = true;
        suppressClick = true;
        marquee.classList.add('is-dragging');
        marquee.setPointerCapture(event.pointerId);
      }

      marquee.scrollLeft = startScroll - dx;
      normalizeLoop();
    });

    const endDrag = (event: PointerEvent) => {
      if (!dragging || event.pointerId !== pointerId) return;
      dragging = false;
      pointerId = null;
      marquee.classList.remove('is-dragging');
      if (marquee.hasPointerCapture(event.pointerId)) {
        marquee.releasePointerCapture(event.pointerId);
      }

      if (marquee.matches(':hover')) {
        paused = true;
      } else {
        scheduleResume();
      }

      // Keep suppressClick through the following click event
      if (suppressClick) {
        window.setTimeout(() => {
          suppressClick = false;
        }, 0);
      }
    };

    marquee.addEventListener('pointerup', endDrag);
    marquee.addEventListener('pointercancel', endDrag);

    marquee.addEventListener(
      'click',
      (event) => {
        if (!suppressClick) return;
        const link = (event.target as HTMLElement | null)?.closest('a[data-gallery-link]');
        if (link) event.preventDefault();
      },
      true,
    );

    // After touch scroll ends, resume autoplay if not hovered
    marquee.addEventListener('touchend', () => scheduleResume(), { passive: true });

    window.addEventListener('beforeunload', () => {
      cancelAnimationFrame(frame);
      window.clearTimeout(resumeTimer);
    });
  }
</script>
