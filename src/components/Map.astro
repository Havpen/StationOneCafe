---
import { site } from '../data/site';

/** Opens Yandex Maps route planner with restaurant as destination */
const navigatorUrl =
  'https://yandex.by/maps/?rtext=~52.4347,31.0095&rtt=auto';
const yandexWidgetUrl =
  'https://yandex.by/map-widget/v1/?ll=31.0095%2C52.4347&mode=search&oid=112602723149&ol=biz&z=16';
---

<section id="map" class="section-pad bg-navy border-y border-white/5">
  <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-center">
    <div class="mx-auto max-w-xl text-center lg:mx-0 lg:text-left">
      <p class="text-xs font-medium uppercase tracking-[0.3em] text-gold">Локация</p>
      <div class="section-heading mx-auto mt-4 lg:mx-0">
        <h2
          class="section-heading-gold font-display text-4xl font-bold leading-tight md:text-5xl"
        >
          Как нас найти
        </h2>
        <span class="section-heading-rule" aria-hidden="true"></span>
      </div>

      <a
        href={navigatorUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 block transition hover:opacity-90"
      >
        <address
          class="not-italic font-display text-3xl font-black leading-tight tracking-tight text-champagne md:text-4xl lg:text-5xl"
        >
          г.&nbsp;Гомель,<br />
          ул.&nbsp;Советская,&nbsp;29А<br />
          <span class="text-gold">2&nbsp;этаж</span>
        </address>
      </a>

      <div class="mt-8 space-y-2 text-base text-silver md:text-lg">
        <a
          href={`tel:${site.phone}`}
          class="block font-semibold tracking-wide text-gold transition hover:text-champagne"
        >
          {site.phoneDisplay}
        </a>
        <p class="font-medium text-champagne/90">{site.openingHoursDisplay}</p>
      </div>

      <a
        href={navigatorUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="book-btn mt-8 inline-flex"
      >
        Построить маршрут <span aria-hidden="true">&nbsp;↗</span>
      </a>
    </div>

    <div class="overflow-hidden rounded-2xl border border-white/10 shadow-2xl shadow-black/20">
      <iframe
        src={yandexWidgetUrl}
        title="Station One Cafe на Яндекс Картах"
        class="h-[22rem] w-full border-0 md:h-[28rem]"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allow="fullscreen"
      ></iframe>
    </div>
  </div>
</section>
