---
const yandexMapUrl = 'https://yandex.by/maps/-/CTCHBF1p';
const yandexWidgetUrl =
  'https://yandex.by/map-widget/v1/?ll=31.0095%2C52.4347&mode=search&oid=112602723149&ol=biz&z=16';
---

<section id="map" class="section-pad bg-navy border-y border-white/5">
  <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
    <div class="mx-auto max-w-xl text-center">
      <div class="section-heading">
        <h2
          class="section-heading-gold font-display text-4xl font-semibold leading-tight md:text-5xl"
        >
          Как нас найти в Гомеле
        </h2>
        <span class="section-heading-rule" aria-hidden="true"></span>
      </div>
      <div class="mt-5 font-accent text-base font-medium leading-relaxed text-silver md:text-lg">
        <address class="not-italic">Гомель, ул. Советская, 29А, 2 этаж.</address>
        <p class="mt-1">
          Постройте маршрут в Яндекс Картах и приходите за атмосферой Station One.
        </p>
      </div>
      <a
        href={yandexMapUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="book-btn mt-8 inline-flex"
      >
        Открыть карты <span aria-hidden="true">&nbsp;↗</span>
      </a>
    </div>

    <div class="overflow-hidden rounded-2xl border border-white/10 shadow-2xl shadow-black/20">
      <iframe
        src={yandexWidgetUrl}
        title="Station One Cafe на Яндекс Картах"
        class="h-[22rem] w-full border-0 md:h-[28rem]"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allow="fullscreen"
      ></iframe>
    </div>
  </div>
</section>
