---
import { site } from '../data/site';

const { latitude, longitude } = site.geo;
const yandexWidgetUrl =
  `https://yandex.by/map-widget/v1/?ll=${longitude}%2C${latitude}&mode=search&oid=112602723149&ol=biz&z=16`;
/** Маршрут с пустой точкой «откуда» и конечной — Station One */
const yandexRouteUrl = `https://yandex.by/maps/?rtext=~${latitude},${longitude}&rtt=auto&z=16`;

const addressLine = `${site.address.city}, ${site.address.street}`;
---

<section id="map" class="section-pad bg-navy border-y border-white/5">
  <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
    <div class="mx-auto max-w-xl text-center">
      <div class="section-heading">
        <h2
          class="section-heading-gold font-display text-4xl font-semibold leading-tight md:text-5xl"
        >
          Как нас найти в Гомеле
        </h2>
        <span class="section-heading-rule" aria-hidden="true"></span>
      </div>

      <div class="mt-8 space-y-4">
        <address class="map-address not-italic">
          {addressLine}
        </address>
        <a
          href={`tel:${site.phone}`}
          class="block font-sans text-xl font-semibold tracking-wide text-gold transition hover:text-champagne md:text-2xl"
        >
          {site.phoneDisplay}
        </a>
        <p class="font-accent text-sm font-medium uppercase tracking-[0.16em] text-silver md:text-base">
          {site.openingHoursDisplay}
        </p>
      </div>

      <a
        href={yandexRouteUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="book-btn mt-8 inline-flex"
      >
        Построить маршрут <span aria-hidden="true">&nbsp;↗</span>
      </a>
    </div>

    <div class="overflow-hidden rounded-2xl border border-white/10 shadow-2xl shadow-black/20">
      <iframe
        src={yandexWidgetUrl}
        title="Station One Cafe на Яндекс Картах"
        class="h-[22rem] w-full border-0 md:h-[28rem]"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allow="fullscreen"
      ></iframe>
    </div>
  </div>
</section>

<style>
  .map-address {
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 4.2vw, 2.75rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.01em;
    color: var(--color-champagne);
    text-wrap: balance;
  }
</style>
