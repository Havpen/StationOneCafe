---
import '../styles/global.css';
import { SITE_URL, site, pageTitle, faqs, withBase } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = pageTitle,
  description = site.description,
  image = site.ogImage,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname === '/404' ? '/' : Astro.url.pathname, SITE_URL).href;
const pageUrl = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL(image, SITE_URL).href;
const logoUrl = new URL(site.logo, SITE_URL).href;
const robots = noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';

const localBusinessLd = {
  '@context': 'https://schema.org',
  '@type': ['Restaurant', 'CafeOrCoffeeShop', 'LocalBusiness'],
  '@id': `${SITE_URL}/#organization`,
  name: site.name,
  alternateName: ['Station One', 'Стэйшн Уан'],
  description: site.description,
  url: SITE_URL,
  logo: logoUrl,
  image: [ogImage, logoUrl],
  telephone: site.phone,
  priceRange: '$$',
  currenciesAccepted: 'BYN',
  paymentAccepted: 'Cash, Credit Card',
  servesCuisine: ['Европейская', 'Белорусская', 'Авторская'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.geo.latitude,
    longitude: site.geo.longitude,
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: [
      'Monday',
      'Tuesday',
      'Wednesday',
      'Thursday',
      'Friday',
      'Saturday',
      'Sunday',
    ],
    opens: '12:00',
    closes: '01:00',
  },
  hasMap: site.social.yandexMaps,
  sameAs: [site.social.instagram, site.social.yandexOrg, site.social.yandexEda],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: String(site.rating.value),
    reviewCount: String(site.rating.count),
    bestRating: String(site.rating.best),
    worstRating: '1',
  },
  potentialAction: {
    '@type': 'ReserveAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `tel:${site.phone}`,
      actionPlatform: [
        'http://schema.org/DesktopWebPlatform',
        'http://schema.org/MobileWebPlatform',
      ],
    },
    result: {
      '@type': 'FoodEstablishmentReservation',
      name: 'Бронь стола',
    },
  },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: site.name,
      item: SITE_URL,
    },
  ],
};

const webpageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: title,
  description,
  isPartOf: {
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    name: site.name,
    url: SITE_URL,
    inLanguage: site.language,
  },
  about: { '@id': `${SITE_URL}/#organization` },
  inLanguage: site.language,
};
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Station One Cafe, Station One Гомель, кафе Гомель, ресторан Гомель, кальян Гомель, кальян-бар Гомель, забронировать стол Гомель, бронь стола Гомель, доставка еды Гомель, заказать еду Гомель, меню кафе Гомель, кафе гомель адрес, Яндекс Еда Station One, кафе Советская Гомель"
    />
    <link rel="canonical" href={noindex ? SITE_URL : canonical} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <meta name="theme-color" content={site.themeColor} />
    <meta name="color-scheme" content="dark" />
    <meta name="format-detection" content="telephone=yes" />
    <meta name="geo.region" content="BY-HO" />
    <meta name="geo.placename" content="Гомель" />
    <meta name="geo.position" content={`${site.geo.latitude};${site.geo.longitude}`} />
    <meta name="ICBM" content={`${site.geo.latitude}, ${site.geo.longitude}`} />
    <meta name="author" content={site.name} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={noindex ? SITE_URL : canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`Интерьер ${site.name}`} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1080" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" type="image/png" href={withBase('/logo-mini.webp')} />
    <link rel="apple-touch-icon" href={withBase('/logo-mini.webp')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    {!noindex && (
      <link
        rel="preload"
        href={withBase('/assets/hero.webp')}
        as="image"
        type="image/webp"
        fetchpriority="high"
      />
    )}

    <script type="application/ld+json" set:html={JSON.stringify(localBusinessLd)} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
    <script type="application/ld+json" set:html={JSON.stringify(webpageLd)} />
  </head>
  <body class="overflow-x-hidden">
    <a href="#main-content" class="sr-only skip-link">
      Перейти к содержимому
    </a>
    <slot />
  </body>
</html>
