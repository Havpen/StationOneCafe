---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Gallery from '../components/Gallery.astro';
import Kitchen from '../components/Kitchen.astro';
import Hookah from '../components/Hookah.astro';
import Reviews from '../components/Reviews.astro';
import Delivery from '../components/Delivery.astro';
import Book from '../components/Book.astro';
import Map from '../components/Map.astro';
import Footer from '../components/Footer.astro';
import { pageTitle, site } from '../data/site';
---

<Layout title={pageTitle} description={site.description}>
  <Header />
  <main id="main-content">
    <Hero />
    <Kitchen />
    <Gallery />
    <Hookah />
    <Delivery />
    <Reviews />
    <Map />
    <Book />
  </main>
  <Footer />
</Layout>
